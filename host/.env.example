# sema_host.py 환경 변수
# 이 파일을 복사하여 host/.env 로 저장하고 값을 수정하세요.

# XBee USB 시리얼 포트
SERIAL_PORT=/dev/ttyUSB0
BAUD=115200

# STATUS 패킷 전달 대상 (bridge.py 수신 주소)
UDP_FWD_IP=127.0.0.1
UDP_FWD_PORT=5005

# CMD 수신 포트 (bridge.py 가 여기로 보냄)
UDP_RECV_IP=0.0.0.0
UDP_RECV_PORT=5006

# 로그 파일 경로 (host/ 기준)
HOST_LOG_FILE=logs/sema_host.log
