# SMA Bridge Configuration — 템플릿
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요
# cp .env.example .env

UDP_LISTEN_IP=0.0.0.0
UDP_PORT=5005

# MQTT → UDP 역방향 포워드 (PD가 수신할 주소)
UDP_FORWARD_IP=127.0.0.1
UDP_FORWARD_PORT=5006

MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# @BotFather에서 발급
TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

LOG_FILE=bridge.log
DB_FILE=sma_data.db

# ── Tapo P110M 스마트플러그 ─────────────────────────────────────────
# TP-Link 계정 (Tapo 앱 로그인 이메일/비밀번호)
TAPO_EMAIL=byungjun@gmail.com
TAPO_PASSWORD=rnjsqudwns1`1

# 전원 차단 후 재투입까지 대기 시간 (초, 기본 5)
TAPO_RESET_SEC=30

# 그룹 번호 → 플러그 IP  (Telegram: /power 1 ~ /power 5)
# TAPO_GROUP_1=192.168.1.101   # 황금칩 꽃
# TAPO_GROUP_2=192.168.1.102   # 황금빛 꽃잎 1
# TAPO_GROUP_3=192.168.1.103   # 황금빛 꽃잎 2
# TAPO_GROUP_4=192.168.1.104   # 비결정적 유영
# TAPO_GROUP_5=192.168.1.105   # 아해들
