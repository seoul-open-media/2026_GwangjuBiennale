# GB16 2026 광주비엔날레 환경 변수
# 이 파일을 복사하여 gb16_host/.env 로 저장하고 값을 수정하세요.
#   cp .env.example .env

# ─── XBee USB 시리얼 ──────────────────────────────────────────────
SERIAL_PORT=/dev/xbee
BAUD=115200

# ─── UDP 포트 (sema와 충돌하지 않도록 6005/6006 사용) ───────────────
UDP_FWD_IP=127.0.0.1
UDP_FWD_PORT=6005

UDP_RECV_IP=0.0.0.0
UDP_RECV_PORT=6006

# bridge.py 쪽 포트 (gb16_bridge.py 와 맞춰야 함)
UDP_PORT=6005
UDP_FORWARD_IP=127.0.0.1
UDP_FORWARD_PORT=6006

# ─── 로그 / DB ────────────────────────────────────────────────────
HOST_LOG_FILE=logs/gb16_host.log
LOG_FILE=gb16_bridge.log
DB_FILE=gb16_data.db
DB_RETENTION_DAYS=7

# ─── MQTT (전용 브로커 권장) ────────────────────────────────────
#
# [외부 인터넷 접속] EMQX Cloud Serverless
#   Host  : k890ff91.ala.asia-southeast1.emqxsl.com
#   MQTT TLS : 8883
#   WSS      : 8084
#   EMQX 대시보드 → Authentication → Add 에서 계정 생성
MQTT_BROKER=k890ff91.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USER=gb16_user
MQTT_PASS=YOUR_STRONG_PASSWORD
MQTT_TLS=1
# MQTT 토픽 프리픽스 (기본값: gb16)
MQTT_TOPIC_PREFIX=gb16

# 대시보드 HTML이 사용할 브로커 WSS URL
# setup_html.sh 에서 HTML에 자동 주입됨
MQTT_BROKER_WSS=wss://k890ff91.ala.asia-southeast1.emqxsl.com:8084/mqtt

# [로컬 LAN 접속] Mosquitto WebSocket URL (mosquitto_setup.sh 실행 후)
MQTT_BROKER_WS=ws://YOUR_GB16_IP:9001/mqtt

# ─── 통계 API / 대시보드 HTTP 서버 ───────────────────────────────
STATS_API_PORT=8182
# 정적 파일(HTML/JS) 경로 — 기본값: gb16_host/ 디렉토리
# sema의 dashboard.html 등을 공유하려면 아래를 설정:
# STATIC_DIR=/home/byungjun/Documents/GitHub/2026_GwangjuBiennale/tools/mqtt_monitor

# ─── ngrok 터널 ───────────────────────────────────────────────────
# ngrok 고정 도메인 (무료 계정: ngrok.com/dashboard → Domains)
NGROK_DOMAIN=YOUR_NGROK_DOMAIN_HERE
STATS_PORT=8182

# ─── Telegram 봇 (선택) ──────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── HTML 셋업 (setup_html.sh 에서 사용) ─────────────────────────
# GB16 서버의 로컬 IP (대시보드 로컬 접속 URL 생성용)
GB16_HOST_IP=192.168.x.x
# 로컬 Mosquitto 브로커 WebSocket 포트 (기본 9001)
MQTT_LOCAL_PORT=9001

# ─── Tapo 스마트플러그 그룹 (선택) ───────────────────────────────
# TAPO_GROUP_1=192.168.0.100   # IF + Bellshaker + Light1
# TAPO_GROUP_2=192.168.0.101   # Domino
# TAPO_GROUP_3=192.168.0.102   # IF Ceiling + Light2
# 그룹별 계정이 필요한 경우(장치가 다른 TP-Link 계정에 묶인 경우)
# TAPO_GROUP_1_EMAIL=other-account@example.com
# TAPO_GROUP_1_PASSWORD=other-account-password

# ─── Audience Camera (Tapo C200/C200C) ──────────────────────────
# Camera static IP should be set from your router DHCP reservation.
# Example: MAC xx:xx:xx:xx:xx:xx -> 192.168.0.200
TAPO_CAM_USER=admin
TAPO_CAM_PASS=YOUR_TAPO_CAMERA_PASSWORD
AUDIENCE_CAMERA_1_IP=192.168.0.200
# Optional second camera:
# AUDIENCE_CAMERA_2_IP=192.168.0.201

# RTSP path for Tapo camera sub-stream
AUDIENCE_CAMERA_RTSP_PATH=/stream2

# Local MJPEG stream port used by gb16_control.html
AUDIENCE_STREAM_PORT=8181

# YOLO audience detection options
AUDIENCE_YOLO_MODEL=/home/byungjun/Documents/GitHub/2026_GwangjuBiennale/tools/mqtt_monitor/yolov8n.pt
AUDIENCE_DETECT_INTERVAL=1.0
AUDIENCE_DETECT_CONF=0.35
AUDIENCE_PRESENT_HITS=2
AUDIENCE_ABSENT_HOLD_SEC=4.0

# ─── Audience -> GB16 PD UDP Trigger ─────────────────────────────
# audience/present true/false 변화 시, GB16 PD로 UDP '1'/'0' 전송
AUDIENCE_PD_UDP_ENABLE=1
AUDIENCE_PD_UDP_IP=192.168.0.12
AUDIENCE_PD_UDP_PORT=7001
